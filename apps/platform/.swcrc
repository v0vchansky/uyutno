{
  "$schema": "https://swc.rs/schema.json",
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "tsx": true,
      "decorators": false
    },
    "transform": {
      "react": {
        "runtime": "automatic",
        "development": false,
        "useBuiltins": true
      }
    },
    "target": "es2022",
    "loose": false,
    "externalHelpers": true
  },
  "module": {
    "type": "es6"
  }
}
